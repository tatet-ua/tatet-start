{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-env.py\"",
            "timeout": 10,
            "statusMessage": "Перевіряю доступ до складу ключів"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/agent-runs.py\" hook",
            "timeout": 20,
            "statusMessage": "Записую запуск агента в журнал"
          }
        ]
      }
    ]
  }
}
